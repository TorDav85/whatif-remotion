   "end": 1.14,
   "text": "Marc devient invisible.",
   "beat": "hook"
  },
  {
   "start": 1.86,
   "end": 3.02,
   "text": "Problème :",
   "beat": "hook"
  },
  {
   "start": 3.02,
   "end": 4.38,
   "text": "il devient aussi aveugle.",
   "beat": "hook"
  },
  {
   "start": 4.8,
   "end": 5.54,
   "text": "Sept heures du matin.",
   "beat": "fade"
  },
  {
   "start": 5.54,
   "end": 7.06,
   "text": "D'abord,",
   "beat": "fade"
  },
  {
   "start": 7.06,
   "end": 8.16,
   "text": "ses mains disparaissent.",
   "beat": "fade"
  },
  {
   "start": 8.62,
   "end": 9.32,
   "text": "Puis ses bras.",
   "beat": "fade"
  },
  {
   "start": 9.94,
   "end": 10.44,
   "text": "Puis tout le reste.",
   "beat": "fade"
  },
  {
   "start": 11.0,
   "end": 12.38,
   "text": "Julien entre.",
   "beat": "julien"
  },
  {
   "start": 12.38,
   "end": 14.5,
   "text": "Une tasse de café flotte",
   "beat": "julien"
  },
  {
   "start": 14.5,
   "end": 15.26,
   "text": "toute seule.",
   "beat": "julien"
  },
  {
   "start": 15.8,
   "end": 16.3,
   "text": "Mais pour voir,",
   "beat": "retina"
  },
  {
   "start": 17.0,
   "end": 17.96,
   "text": "il faut que la rétine",
   "beat": "retina"
  },
  {
   "start": 17.96,
   "end": 19.4,
   "text": "arrête la lumière.",
   "beat": "retina"
  },
  {
   "start": 20.12,
   "end": 21.82,
   "text": "Celle de Marc la laisse",
   "beat": "retina"
  },
  {
   "start": 21.82,
   "end": 22.14,
   "text": "passer.",
   "beat": "retina"
  },
  {
   "start": 23.4,
   "end": 24.36,
   "text": "Marc est invisible...",
   "beat": "blind"
  },
  {
   "start": 24.36,
   "end": 25.78,
   "text": "et il ne voit plus",
   "beat": "blind"
  },
  {
   "start": 25.78,
   "end": 26.04,
   "text": "rien.",
   "beat": "blind"
  },
  {
   "start": 26.72,
   "end": 27.44,
   "text": "Le noir complet.",
   "beat": "blind"
  },
  {
   "start": 29.0,
   "end": 29.6,
   "text": "Il sort quand même.",
   "beat": "street"
  },
  {
   "start": 30.4,
   "end": 30.94,
   "text": "Dans la rue,",
   "beat": "street"
  },
  {
   "start": 31.5,
   "end": 33.2,
   "text": "personne ne l'évite.",
   "beat": "street"
  },
  {
   "start": 33.2,
   "end": 34.22,
   "text": "Un vélo le percute de",
   "beat": "street"
  },
  {
   "start": 34.22,
   "end": 34.7,
   "text": "plein fouet.",
   "beat": "street"
  },
  {
   "start": 35.8,
   "end": 36.34,
   "text": "Mais son corps est",
   "beat": "heat"
  },
  {
   "start": 36.34,
   "end": 37.08,
   "text": "toujours à trente-sept",
   "beat": "heat"
  },
  {
   "start": 37.08,
   "end": 38.18,
   "text": "degrés.",
   "beat": "heat"
  },
  {
   "start": 38.18,
   "end": 39.24,
   "text": "Il rayonne environ cent",
   "beat": "heat"
  },
  {
   "start": 39.24,
   "end": 40.04,
   "text": "watts de chaleur.",
   "beat": "heat"
  },
  {
   "start": 43.0,
   "end": 44.14,
   "text": "Une caméra thermique de la",
   "beat": "camera"
  },
  {
   "start": 44.14,
   "end": 45.92,
   "text": "police le voit comme en",
   "beat": "camera"
  },
  {
   "start": 45.92,
   "end": 46.36,
   "text": "plein jour.",
   "beat": "camera"
  },
  {
   "start": 49.2,
   "end": 49.52,
   "text": "Midi.",
   "beat": "food"
  },
  {
   "start": 49.52,
   "end": 51.32,
   "text": "Marc mange un sandwich.",
   "beat": "food"
  },
  {
   "start": 52.16,
   "end": 53.72,
   "text": "Le pain mâché flotte dans",
   "beat": "food"
  },
  {
   "start": 53.72,
   "end": 54.16,
   "text": "le vide,",
   "beat": "food"
  },
  {
   "start": 54.74,
   "end": 55.98,
   "text": "au milieu de son ventre.",
   "beat": "food"
  },
  {
   "start": 56.4,
   "end": 57.34,
   "text": "Il reste visible",
   "beat": "digest"
  },
  {
   "start": 57.92,
   "end": 59.1,
