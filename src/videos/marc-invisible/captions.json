   "beat": "digest"
  },
  {
   "start": 62.6,
   "end": 63.46,
   "text": "Bilan :",
   "beat": "punch"
  },
  {
   "start": 63.46,
   "end": 63.98,
   "text": "aveugle,",
   "beat": "punch"
  },
  {
   "start": 64.5,
   "end": 65.8,
   "text": "repérable à la chaleur,",
   "beat": "punch"
  },
  {
   "start": 66.2,
   "end": 67.12,
   "text": "trahi par son déjeuner.",
   "beat": "punch"
  },
  {
   "start": 67.74,
   "end": 68.72,
   "text": "Le pire espion du monde.",
   "beat": "punch"
  },
  {
   "start": 70.0,
   "end": 71.12,
   "text": "Et toi :",
   "beat": "cta"
