  {
   "start": 0.2,
   "end": 1.36,
   "text": "Une machine de cent mètres",
   "beat": "hook"
  },
  {
   "start": 1.36,
   "end": 2.18,
   "text": "creuse sous la ville,",
   "beat": "hook"
  },
  {
   "start": 2.18,
   "end": 3.6,
   "text": "sans que rien ne",
   "beat": "hook"
  },
  {
   "start": 3.6,
   "end": 4.0,
   "text": "s'effondre.",
   "beat": "hook"
  },
  {
   "start": 6.2,
   "end": 7.16,
   "text": "À l'avant,",
   "beat": "wheel"
  },
  {
   "start": 7.16,
   "end": 8.92,
   "text": "une roue géante tourne",
   "beat": "wheel"
  },
  {
   "start": 8.92,
   "end": 9.36,
   "text": "lentement.",
   "beat": "wheel"
  },
  {
   "start": 9.36,
   "end": 11.16,
   "text": "Ses molettes broient la",
   "beat": "wheel"
  },
  {
   "start": 11.16,
   "end": 11.52,
   "text": "roche.",
   "beat": "wheel"
  },
  {
   "start": 13.0,
   "end": 14.28,
   "text": "Derrière la roue,",
   "beat": "pressure"
  },
  {
   "start": 14.28,
   "end": 15.46,
   "text": "la terre broyée reste sous",
   "beat": "pressure"
  },
  {
   "start": 15.46,
   "end": 15.92,
   "text": "pression.",
   "beat": "pressure"
  },
  {
   "start": 16.24,
   "end": 17.44,
   "text": "Elle retient le sol,",
   "beat": "pressure"
  },
  {
   "start": 17.44,
   "end": 18.7,
   "text": "comme un bouchon.",
   "beat": "pressure"
  },
  {
   "start": 21.2,
   "end": 23.12,
   "text": "Une vis sans fin évacue",
   "beat": "screw"
  },
  {
   "start": 23.12,
   "end": 23.74,
   "text": "les déblais vers",
   "beat": "screw"
  },
  {
   "start": 23.74,
   "end": 24.48,
   "text": "l'arrière,",
   "beat": "screw"
  },
  {
   "start": 24.48,
   "end": 26.58,
   "text": "sur un tapis roulant.",
   "beat": "screw"
  },
  {
   "start": 27.2,
   "end": 28.82,
   "text": "Des vérins poussent la",
   "beat": "thrust"
  },
  {
   "start": 28.82,
   "end": 30.82,
   "text": "machine en prenant appui",
   "beat": "thrust"
  },
  {
   "start": 30.82,
   "end": 31.8,
   "text": "sur le tunnel déjà",
   "beat": "thrust"
  },
  {
   "start": 31.8,
   "end": 32.42,
   "text": "construit.",
   "beat": "thrust"
  },
  {
   "start": 34.0,
   "end": 35.08,
   "text": "Puis un bras robotisé",
   "beat": "ring"
  },
  {
   "start": 35.5,
   "end": 36.46,
   "text": "pose un anneau de",
   "beat": "ring"
  },
  {
   "start": 36.46,
   "end": 37.42,
   "text": "voussoirs en béton.",
   "beat": "ring"
  },
  {
   "start": 37.42,
   "end": 38.98,
   "text": "Et on recommence.",
   "beat": "ring"
  },
  {
   "start": 41.2,
   "end": 41.89,
   "text": "Combien de mètres",
   "beat": "end"
  },
  {
   "start": 41.89,
   "end": 42.76,
   "text": "creuse-t-il par jour,",
   "beat": "end"
  },
  {
   "start": 43.36,
   "end": 43.94,
   "text": "à ton avis ?",
   "beat": "end"
  }
