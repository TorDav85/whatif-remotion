  {
   "start": 0.2,
   "end": 0.94,
   "text": "Cinq cent soixante-quinze",
   "beat": "hook"
  },
  {
   "start": 0.94,
   "end": 1.58,
   "text": "tonnes.",
   "beat": "hook"
  },
  {
   "start": 2.26,
   "end": 2.84,
   "text": "Et pourtant,",
   "beat": "hook"
  },
  {
   "start": 3.38,
   "end": 5.02,
   "text": "cet avion tient dans le",
   "beat": "hook"
  },
  {
   "start": 5.02,
   "end": 5.28,
   "text": "ciel.",
   "beat": "hook"
  },
  {
   "start": 6.2,
   "end": 7.1,
   "text": "Son poids le tire vers",
   "beat": "weight"
  },
  {
   "start": 7.1,
   "end": 7.48,
   "text": "le bas.",
   "beat": "weight"
  },
  {
   "start": 8.24,
   "end": 9.28,
   "text": "Il faut une force égale",
   "beat": "weight"
  },
  {
   "start": 9.28,
   "end": 10.233,
   "text": "vers le haut :",
   "beat": "weight"
  },
  {
   "start": 10.233,
   "end": 11.06,
   "text": "la portance.",
   "beat": "weight"
  },
  {
   "start": 13.2,
   "end": 14.9,
   "text": "Son aile est bombée et",
   "beat": "wing"
  },
  {
   "start": 14.9,
   "end": 15.42,
   "text": "inclinée.",
   "beat": "wing"
  },
  {
   "start": 15.92,
   "end": 17.0,
   "text": "Elle pousse l'air vers le",
   "beat": "wing"
  },
  {
   "start": 17.0,
   "end": 17.26,
   "text": "bas,",
   "beat": "wing"
  },
  {
   "start": 17.26,
   "end": 18.58,
   "text": "et l'air la pousse vers",
   "beat": "wing"
  },
  {
   "start": 18.58,
   "end": 18.84,
   "text": "le haut.",
   "beat": "wing"
  },
  {
   "start": 22.4,
   "end": 23.5,
   "text": "Tout dépend de la vitesse",
   "beat": "speed"
  },
  {
   "start": 23.5,
   "end": 24.14,
   "text": ":",
   "beat": "speed"
  },
  {
   "start": 24.14,
   "end": 25.4,
   "text": "deux fois plus vite,",
   "beat": "speed"
  },
  {
   "start": 25.88,
   "end": 27.24,
   "text": "quatre fois plus de",
   "beat": "speed"
  },
  {
   "start": 27.24,
   "end": 27.8,
   "text": "portance.",
   "beat": "speed"
  },
  {
   "start": 29.4,
   "end": 30.42,
   "text": "Trop lent ?",
   "beat": "stall"
  },
  {
   "start": 30.42,
   "end": 31.965,
   "text": "La portance s'effondre :",
   "beat": "stall"
  },
  {
   "start": 31.965,
   "end": 33.1,
   "text": "c'est le décrochage.",
   "beat": "stall"
  },
  {
   "start": 34.2,
   "end": 35.36,
   "text": "La règle :",
   "beat": "rule"
  },
  {
   "start": 35.36,
   "end": 36.36,
   "text": "avec assez de vitesse,",
   "beat": "rule"
  },
  {
   "start": 37.12,
   "end": 38.62,
   "text": "chaque mètre carré d'aile",
   "beat": "rule"
  },
  {
   "start": 38.62,
   "end": 40.24,
   "text": "porte près de sept cents",
   "beat": "rule"
  },
  {
   "start": 40.24,
   "end": 40.54,
   "text": "kilos.",
   "beat": "rule"
  },
  {
   "start": 41.2,
   "end": 42.36,
   "text": "Et là-haut,",
   "beat": "end"
  },
  {
   "start": 42.36,
   "end": 43.12,
   "text": "où l'air est trois fois",
   "beat": "end"
  },
  {
   "start": 43.12,
   "end": 43.54,
   "text": "plus léger ?",
   "beat": "end"
  }
 ],
