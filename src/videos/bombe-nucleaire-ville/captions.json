  {
   "start": 0.25,
   "end": 1.63,
   "text": "Et si une bombe nucléaire",
   "beat": "hook"
  },
  {
   "start": 1.63,
   "end": 3.03,
   "text": "tombait sur cette ville ?",
   "beat": "hook"
  },
  {
   "start": 4.25,
   "end": 5.31,
   "text": "Marc part travailler.",
   "beat": "marc"
  },
  {
   "start": 5.99,
   "end": 6.85,
   "text": "Il ne voit rien venir.",
   "beat": "marc"
  },
  {
   "start": 8.25,
   "end": 9.29,
   "text": "D'abord,",
   "beat": "flash"
  },
  {
   "start": 9.29,
   "end": 9.79,
   "text": "un flash.",
   "beat": "flash"
  },
  {
   "start": 10.73,
   "end": 11.99,
   "text": "La lumière arrive avant le",
   "beat": "flash"
  },
  {
   "start": 11.99,
   "end": 12.35,
   "text": "souffle.",
   "beat": "flash"
  },
  {
   "start": 13.25,
   "end": 14.23,
   "text": "La chaleur peut déclencher",
   "beat": "heat"
  },
  {
   "start": 14.23,
   "end": 15.19,
   "text": "des incendies,",
   "beat": "heat"
  },
  {
   "start": 15.23,
   "end": 16.53,
   "text": "loin du point d'explosion.",
   "beat": "heat"
  },
  {
   "start": 18.25,
   "end": 19.13,
   "text": "Puis le souffle frappe.",
   "beat": "shock"
  },
  {
   "start": 19.87,
   "end": 21.65,
   "text": "Les vitres éclatent.",
   "beat": "shock"
  },
  {
   "start": 21.67,
   "end": 22.81,
   "text": "Des murs s'effondrent.",
   "beat": "shock"
  },
  {
   "start": 24.25,
   "end": 25.15,
   "text": "Le champignon monte.",
   "beat": "cloud"
  },
  {
   "start": 25.79,
   "end": 27.51,
   "text": "Mais le danger ne s'arrête",
   "beat": "cloud"
  },
  {
   "start": 27.51,
   "end": 27.77,
   "text": "pas là.",
   "beat": "cloud"
  },
  {
   "start": 29.25,
   "end": 29.63,
   "text": "Au centre,",
   "beat": "ruins"
  },
  {
   "start": 29.63,
   "end": 30.77,
   "text": "des rues sont détruites.",
   "beat": "ruins"
  },
  {
   "start": 31.13,
   "end": 31.89,
   "text": "Plus loin,",
   "beat": "ruins"
  },
  {
   "start": 32.41,
   "end": 33.41,
   "text": "des bâtiments tiennent.",
   "beat": "ruins"
  },
  {
   "start": 34.25,
   "end": 35.27,
   "text": "Marc rejoint le sous-sol",
   "beat": "shelter"
  },
  {
   "start": 35.27,
   "end": 36.07,
   "text": "d'un bâtiment encore",
   "beat": "shelter"
  },
  {
   "start": 36.07,
   "end": 36.53,
   "text": "solide.",
   "beat": "shelter"
  },
  {
   "start": 40.71,
   "end": 41.11,
   "text": "Dehors,",
   "beat": "fallout"
  },
  {
   "start": 41.37,
   "end": 42.53,
   "text": "le vent peut emporter des",
   "beat": "fallout"
  },
  {
   "start": 42.53,
   "end": 43.79,
   "text": "poussières radioactives",
   "beat": "fallout"
  },
  {
   "start": 43.79,
   "end": 44.35,
   "text": "bien plus loin.",
   "beat": "fallout"
  },
  {
   "start": 46.25,
   "end": 48.21,
   "text": "Marc reste à l'abri et",
   "beat": "radio"
  },
  {
   "start": 48.21,
   "end": 49.25,
   "text": "écoute les consignes à la",
   "beat": "radio"
  },
  {
   "start": 49.25,
   "end": 49.43,
   "text": "radio.",
   "beat": "radio"
  },
  {
   "start": 52.3,
   "end": 53.22,
   "text": "Marc se fige.",
   "beat": "freeze"
  },
  {
   "start": 55.3,
   "end": 55.6,
   "text": "Marc...",
   "beat": "julien"
  },
  {
   "start": 55.6,
   "end": 57.0,
   "text": "c'est Julien.",
   "beat": "julien"
  },
  {
   "start": 57.0,
   "end": 58.14,
   "text": "Ouvre-moi.",
   "beat": "julien"
  }
 ],
