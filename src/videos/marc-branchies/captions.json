  {
   "start": 0.2,
   "end": 1.28,
   "text": "Marc peut respirer sous",
   "beat": "hook"
  },
  {
   "start": 1.28,
   "end": 1.96,
   "text": "l'eau.",
   "beat": "hook"
  },
  {
   "start": 1.96,
   "end": 3.06,
   "text": "Et c'est là qu'il va",
   "beat": "hook"
  },
  {
   "start": 3.06,
   "end": 3.34,
   "text": "étouffer.",
   "beat": "hook"
  },
  {
   "start": 4.8,
   "end": 5.78,
   "text": "Ses poumons deviennent des",
   "beat": "plunge"
  },
  {
   "start": 5.78,
   "end": 6.28,
   "text": "branchies.",
   "beat": "plunge"
  },
  {
   "start": 6.28,
   "end": 7.94,
   "text": "Il saute dans la Seine,",
   "beat": "plunge"
  },
  {
   "start": 7.94,
   "end": 9.08,
   "text": "du pont des Arts.",
   "beat": "plunge"
  },
  {
   "start": 10.8,
   "end": 12.1,
   "text": "Premier problème :",
   "beat": "oxygen"
  },
  {
   "start": 12.1,
   "end": 13.34,
   "text": "un litre d'eau contient",
   "beat": "oxygen"
  },
  {
   "start": 13.34,
   "end": 13.98,
   "text": "trente fois moins",
   "beat": "oxygen"
  },
  {
   "start": 13.98,
   "end": 15.38,
   "text": "d'oxygène qu'un litre",
   "beat": "oxygen"
  },
  {
   "start": 15.38,
   "end": 15.66,
   "text": "d'air.",
   "beat": "oxygen"
  },
  {
   "start": 18.0,
   "end": 19.26,
   "text": "Pour survivre,",
   "beat": "litres"
  },
  {
   "start": 19.26,
   "end": 20.32,
   "text": "Marc doit faire passer",
   "beat": "litres"
  },
  {
   "start": 20.32,
   "end": 21.14,
   "text": "près de cinquante litres",
   "beat": "litres"
  },
  {
   "start": 21.14,
   "end": 23.02,
   "text": "d'eau par minute dans ses",
   "beat": "litres"
  },
  {
   "start": 23.02,
   "end": 23.16,
   "text": "branchies.",
   "beat": "litres"
  },
  {
   "start": 25.8,
   "end": 26.68,
   "text": "Une baignoire pleine",
   "beat": "bath"
  },
  {
   "start": 26.68,
   "end": 27.4,
   "text": "toutes les trois minutes.",
   "beat": "bath"
  },
  {
   "start": 31.0,
   "end": 31.56,
   "text": "Et l'eau est huit cents",
   "beat": "heavy"
  },
  {
   "start": 31.56,
   "end": 32.34,
   "text": "fois plus lourde que",
   "beat": "heavy"
  },
  {
   "start": 32.34,
   "end": 33.34,
   "text": "l'air.",
   "beat": "heavy"
  },
  {
   "start": 33.34,
   "end": 34.36,
   "text": "Rien que respirer le",
   "beat": "heavy"
  },
  {
   "start": 34.36,
   "end": 34.62,
   "text": "fatigue.",
   "beat": "heavy"
  },
  {
   "start": 37.8,
   "end": 38.32,
   "text": "S'il nage,",
   "beat": "swim"
  },
  {
   "start": 39.04,
   "end": 40.56,
   "text": "il lui faut jusqu'à dix",
   "beat": "swim"
  },
  {
   "start": 40.56,
   "end": 41.8,
   "text": "fois plus d'oxygène.",
   "beat": "swim"
  },
  {
   "start": 41.8,
   "end": 43.38,
   "text": "Impossible à filtrer.",
   "beat": "swim"
  },
  {
   "start": 43.8,
   "end": 44.99,
   "text": "Deuxième problème :",
   "beat": "cold"
  },
  {
   "start": 44.99,
   "end": 46.5,
   "text": "ses branchies touchent",
   "beat": "cold"
  },
  {
   "start": 46.5,
   "end": 47.22,
   "text": "l'eau froide.",
   "beat": "cold"
  },
  {
   "start": 47.92,
   "end": 48.98,
   "text": "Tout son sang y passe,",
   "beat": "cold"
  },
  {
   "start": 48.98,
   "end": 50.3,
   "text": "et se refroidit.",
   "beat": "cold"
  },
  {
   "start": 51.0,
   "end": 51.9,
   "text": "Dans une Seine à quinze",
   "beat": "hypo"
  },
  {
   "start": 51.9,
   "end": 53.02,
   "text": "degrés,",
   "beat": "hypo"
  },
  {
   "start": 53.02,
   "end": 54.78,
   "text": "son corps perd sa chaleur,",
   "beat": "hypo"
  },
  {
   "start": 55.12,
   "end": 55.96,
   "text": "heure après heure.",
   "beat": "hypo"
  },
  {
   "start": 57.8,
   "end": 58.48,
   "text": "Voilà pourquoi presque",
   "beat": "fish"
  },
  {
   "start": 58.48,
   "end": 59.8,
   "text": "tous les poissons ont le",
   "beat": "fish"
  },
  {
   "start": 59.8,
   "end": 60.3,
   "text": "sang froid.",
   "beat": "fish"
  },
  {
   "start": 60.86,
   "end": 62.12,
   "text": "Ils sont à la température",
   "beat": "fish"
  },
  {
   "start": 62.12,
   "end": 62.36,
   "text": "de l'eau.",
   "beat": "fish"
  },
  {
   "start": 64.4,
   "end": 64.86,
   "text": "Des branchies,",
   "beat": "punch"
  },
  {
   "start": 64.86,
   "end": 65.48,
   "text": "ça ne suffit pas.",
   "beat": "punch"
  },
  {
   "start": 66.18,
   "end": 67.14,
   "text": "Il faudrait à Marc un",
   "beat": "punch"
  },
  {
   "start": 67.14,
   "end": 67.8,
   "text": "corps de poisson.",
   "beat": "punch"
  },
  {
   "start": 70.0,
   "end": 70.32,
   "text": "Et toi,",
   "beat": "cta"
  },
  {
   "start": 71.14,
   "end": 72.18,
   "text": "tu voudrais vivre sous",
   "beat": "cta"
  },
  {
   "start": 72.18,
   "end": 72.78,
   "text": "l'eau,",
   "beat": "cta"
  },
  {
   "start": 72.78,
   "end": 74.42,
   "text": "ou tu gardes tes poumons",
   "beat": "cta"
  },
  {
   "start": 74.42,
   "end": 74.42,
   "text": "?",
   "beat": "cta"
  }
