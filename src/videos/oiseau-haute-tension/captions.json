 "segments": [
  {
   "start": 0.2,
   "end": 1.08,
   "text": "Vingt mille volts sous ses",
   "beat": "hook"
  },
  {
   "start": 1.08,
   "end": 2.18,
   "text": "pattes.",
   "beat": "hook"
  },
  {
   "start": 2.18,
   "end": 2.6,
   "text": "Et pourtant,",
   "beat": "hook"
  },
  {
   "start": 3.34,
   "end": 4.46,
   "text": "cet oiseau ne sent rien.",
   "beat": "hook"
  },
  {
   "start": 6.2,
   "end": 7.14,
   "text": "Le courant file dans le",
   "beat": "flow"
  },
  {
   "start": 7.14,
   "end": 7.58,
   "text": "câble.",
   "beat": "flow"
  },
  {
   "start": 7.98,
   "end": 9.14,
   "text": "Il prend le chemin qui",
   "beat": "flow"
  },
  {
   "start": 9.14,
   "end": 9.98,
   "text": "lui résiste le moins.",
   "beat": "flow"
  },
  {
   "start": 12.2,
   "end": 13.1,
   "text": "Ses deux pattes touchent",
   "beat": "feet"
  },
  {
   "start": 13.1,
   "end": 13.52,
   "text": "le même fil,",
   "beat": "feet"
  },
  {
   "start": 14.16,
   "end": 15.14,
   "text": "au même potentiel.",
   "beat": "feet"
  },
  {
   "start": 15.64,
   "end": 16.4,
   "text": "Aucune différence,",
   "beat": "feet"
  },
  {
   "start": 17.16,
   "end": 17.68,
   "text": "aucun courant.",
   "beat": "feet"
  },
  {
   "start": 18.4,
   "end": 19.44,
   "text": "Et si son aile touchait",
   "beat": "contact"
  },
  {
   "start": 19.44,
   "end": 20.08,
   "text": "le pylône,",
   "beat": "contact"
  },
  {
   "start": 20.54,
   "end": 21.68,
   "text": "relié à la terre ?",
   "beat": "contact"
  },
  {
   "start": 24.2,
   "end": 25.92,
   "text": "Onze mille volts d'écart.",
   "beat": "arc"
  },
  {
   "start": 25.92,
   "end": 27.04,
   "text": "Le courant traverse son",
   "beat": "arc"
  },
  {
   "start": 27.04,
   "end": 27.46,
   "text": "corps.",
   "beat": "arc"
  },
  {
   "start": 27.46,
   "end": 28.86,
   "text": "C'est ce qui tue les",
   "beat": "arc"
  },
  {
   "start": 28.86,
   "end": 30.78,
   "text": "cigognes et les rapaces.",
   "beat": "arc"
  },
  {
   "start": 32.4,
   "end": 33.56,
   "text": "La règle :",
   "beat": "rule"
  },
  {
   "start": 33.56,
   "end": 34.72,
   "text": "le courant ne traverse un",
   "beat": "rule"
  },
  {
   "start": 34.72,
   "end": 35.84,
   "text": "corps que s'il relie deux",
   "beat": "rule"
  },
  {
   "start": 35.84,
   "end": 36.76,
   "text": "potentiels différents.",
   "beat": "rule"
  },
  {
   "start": 37.48,
   "end": 38.28,
   "text": "Sur un seul fil,",
   "beat": "rule"
  },
  {
   "start": 38.82,
   "end": 39.46,
   "text": "rien ne passe.",
   "beat": "rule"
  },
  {
   "start": 41.2,
   "end": 42.44,
   "text": "Et l'écureuil,",
   "beat": "end"
  },
  {
   "start": 42.44,
   "end": 43.66,
   "text": "pourquoi fait-il sauter le",
   "beat": "end"
  },
  {
   "start": 43.66,
   "end": 43.92,
   "text": "courant ?",
   "beat": "end"
  }
 ],
