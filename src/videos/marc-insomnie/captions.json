   "text": "Jamais.",
   "beat": "hook"
  },
  {
   "start": 2.64,
   "end": 3.44,
   "text": "Et son cerveau va le",
   "beat": "hook"
  },
  {
   "start": 3.44,
   "end": 3.98,
   "text": "lui faire payer.",
   "beat": "hook"
  },
  {
   "start": 4.8,
   "end": 5.22,
   "text": "Première nuit.",
   "beat": "night"
  },
  {
   "start": 5.84,
   "end": 6.7,
   "text": "Trois heures du matin,",
   "beat": "night"
  },
  {
   "start": 6.78,
   "end": 7.24,
   "text": "il range tout",
   "beat": "night"
  },
  {
   "start": 7.24,
   "end": 7.93,
   "text": "l'appartement.",
   "beat": "night"
  },
  {
   "start": 7.93,
   "end": 9.12,
   "text": "Il se sent invincible.",
   "beat": "night"
  },
  {
   "start": 10.8,
   "end": 11.46,
   "text": "Quarante-huit heures.",
   "beat": "day2"
  },
  {
   "start": 12.32,
   "end": 13.2,
   "text": "Il oublie ses clés,",
   "beat": "day2"
  },
  {
   "start": 13.3,
   "end": 13.66,
   "text": "ses mots,",
   "beat": "day2"
  },
  {
   "start": 13.66,
   "end": 15.48,
   "text": "et le prénom de Julien.",
   "beat": "day2"
  },
  {
   "start": 16.8,
   "end": 18.46,
   "text": "Puis son cerveau triche :",
   "beat": "micro"
  },
  {
   "start": 18.46,
   "end": 20.28,
   "text": "il s'endort une seconde,",
   "beat": "micro"
  },
  {
   "start": 20.34,
   "end": 21.3,
   "text": "les yeux ouverts.",
   "beat": "micro"
  },
  {
   "start": 21.82,
   "end": 22.72,
   "text": "Des micro-sommeils.",
   "beat": "micro"
  },
  {
   "start": 23.8,
   "end": 24.28,
   "text": "À cent dix sur",
   "beat": "car"
  },
  {
   "start": 24.28,
   "end": 25.32,
   "text": "l'autoroute,",
   "beat": "car"
  },
  {
   "start": 25.32,
   "end": 26.26,
   "text": "une seconde,",
   "beat": "car"
  },
  {
   "start": 26.26,
   "end": 27.7,
   "text": "c'est trente mètres sans",
   "beat": "car"
  },
  {
   "start": 27.7,
   "end": 28.24,
   "text": "conducteur.",
   "beat": "car"
  },
  {
   "start": 29.4,
   "end": 30.38,
   "text": "Jour quatre.",
   "beat": "halluc"
  },
  {
   "start": 30.38,
   "end": 31.7,
   "text": "Il hallucine :",
   "beat": "halluc"
  },
  {
   "start": 31.7,
   "end": 32.82,
   "text": "le panneau de la rue",
   "beat": "halluc"
  },
  {
   "start": 32.82,
   "end": 33.76,
   "text": "devient un homme qui le",
   "beat": "halluc"
  },
  {
   "start": 33.76,
   "end": 34.14,
   "text": "fixe.",
   "beat": "halluc"
  },
  {
   "start": 36.0,
   "end": 37.3,
   "text": "Jour onze.",
   "beat": "record"
  },
  {
   "start": 37.3,
   "end": 38.52,
   "text": "Il égale le record de",
   "beat": "record"
  },
  {
   "start": 38.52,
   "end": 39.88,
   "text": "Randy Gardner :",
   "beat": "record"
  },
  {
   "start": 39.88,
   "end": 41.26,
   "text": "deux cent soixante-quatre",
   "beat": "record"
  },
  {
   "start": 41.26,
   "end": 42.0,
   "text": "heures sans dormir.",
   "beat": "record"
  },
  {
   "start": 43.8,
   "end": 44.18,
   "text": "Gardner,",
   "beat": "gardner"
  },
  {
   "start": 44.18,
   "end": 44.38,
   "text": "lui,",
   "beat": "gardner"
  },
  {
   "start": 44.38,
   "end": 45.18,
   "text": "s'est arrêté là.",
   "beat": "gardner"
  },
  {
   "start": 45.84,
   "end": 47.68,
   "text": "Puis il a dormi quatorze",
   "beat": "gardner"
  },
  {
   "start": 47.68,
   "end": 48.32,
   "text": "heures d'affilée.",
   "beat": "gardner"
  },
  {
   "start": 49.4,
   "end": 50.52,
   "text": "Au-delà,",
   "beat": "unknown"
  },
  {
   "start": 50.52,
   "end": 51.32,
   "text": "aucun humain n'a été",
   "beat": "unknown"
  },
  {
   "start": 51.32,
   "end": 51.86,
   "text": "testé.",
   "beat": "unknown"
  },
  {
   "start": 52.54,
   "end": 53.04,
   "text": "Chez les rats,",
   "beat": "unknown"
  },
  {
   "start": 53.9,
   "end": 55.12,
   "text": "la privation totale tue en",
   "beat": "unknown"
  },
  {
   "start": 55.12,
   "end": 55.94,
   "text": "deux à quatre semaines.",
   "beat": "unknown"
  },
  {
   "start": 57.4,
   "end": 58.52,
   "text": "Leur température chute,",
   "beat": "why"
  },
  {
   "start": 59.14,
   "end": 60.94,
   "text": "leur corps s'épuise.",
   "beat": "why"
  },
  {
   "start": 60.94,
   "end": 61.8,
   "text": "Et on ne sait toujours",
   "beat": "why"
  },
  {
   "start": 61.8,
   "end": 62.9,
   "text": "pas exactement pourquoi",
   "beat": "why"
  },
  {
   "start": 62.9,
   "end": 63.38,
   "text": "ils meurent.",
   "beat": "why"
  },
  {
   "start": 64.8,
   "end": 65.32,
   "text": "Chez la souris,",
   "beat": "clean"
  },
  {
   "start": 65.96,
   "end": 67.12,
   "text": "le cerveau fait le ménage",
   "beat": "clean"
  },
  {
   "start": 67.12,
   "end": 67.64,
   "text": "en dormant.",
   "beat": "clean"
  },
  {
   "start": 68.3,
   "end": 69.26,
   "text": "Privé de sommeil,",
   "beat": "clean"
  },
  {
   "start": 69.5,
   "end": 70.68,
   "text": "il ronge ses connexions.",
   "beat": "clean"
  },
  {
   "start": 71.6,
   "end": 72.52,
   "text": "Marc n'a pas besoin d'un",
   "beat": "punch"
  },
  {
   "start": 72.52,
   "end": 72.82,
   "text": "café.",
   "beat": "punch"
  },
  {
   "start": 73.66,
   "end": 74.54,
   "text": "Il a besoin d'un lit.",
   "beat": "punch"
  },
  {
   "start": 76.0,
   "end": 76.3,
   "text": "Et toi,",
   "beat": "cta"
  },
  {
   "start": 77.12,
   "end": 78.04,
   "text": "tu as dormi combien",
   "beat": "cta"
  },
  {
   "start": 78.04,
   "end": 78.84,
   "text": "d'heures cette nuit ?",
   "beat": "cta"
  }
