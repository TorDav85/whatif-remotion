 "segments": [
  {
   "start": 0.2,
   "end": 0.54,
   "text": "En une nuit,",
   "beat": "hook"
  },
  {
   "start": 1.12,
   "end": 1.82,
   "text": "le cerveau de Marc",
   "beat": "hook"
  },
  {
   "start": 2.32,
   "end": 3.02,
   "text": "rétrécit.",
   "beat": "hook"
  },
  {
   "start": 3.54,
   "end": 4.38,
   "text": "Il tient dans une noix.",
   "beat": "hook"
  },
  {
   "start": 4.8,
   "end": 5.66,
   "text": "Cent fois plus léger.",
   "beat": "skull"
  },
  {
   "start": 6.24,
   "end": 6.84,
   "text": "Son crâne,",
   "beat": "skull"
  },
  {
   "start": 6.84,
   "end": 7.02,
   "text": "lui,",
   "beat": "skull"
  },
  {
   "start": 7.02,
   "end": 9.12,
   "text": "ne change pas :",
   "beat": "skull"
  },
  {
   "start": 9.12,
   "end": 10.2,
   "text": "le cerveau flotte au",
   "beat": "skull"
  },
  {
   "start": 10.2,
   "end": 10.38,
   "text": "milieu.",
   "beat": "skull"
  },
  {
   "start": 11.0,
   "end": 11.72,
   "text": "Un cerveau humain,",
   "beat": "neurons"
  },
  {
   "start": 11.72,
   "end": 12.22,
   "text": "c'est quatre-vingt-six",
   "beat": "neurons"
  },
  {
   "start": 12.22,
   "end": 13.84,
   "text": "milliards de neurones.",
   "beat": "neurons"
  },
  {
   "start": 13.84,
   "end": 15.82,
   "text": "Le sien en garde moins",
   "beat": "neurons"
  },
  {
   "start": 15.82,
   "end": 16.44,
   "text": "d'un milliard.",
   "beat": "neurons"
  },
  {
   "start": 17.8,
   "end": 18.58,
   "text": "Il cherche ses mots.",
   "beat": "words"
  },
  {
   "start": 19.3,
   "end": 20.0,
   "text": "Il ne reconnaît plus",
   "beat": "words"
  },
  {
   "start": 20.0,
   "end": 20.42,
   "text": "Julien.",
   "beat": "words"
  },
  {
   "start": 21.14,
   "end": 22.7,
   "text": "Il oublie ce qu'il",
   "beat": "words"
  },
  {
   "start": 22.7,
   "end": 22.96,
   "text": "faisait.",
   "beat": "words"
  },
  {
   "start": 24.4,
   "end": 25.42,
   "text": "Même la zone qui gère",
   "beat": "balance"
  },
  {
   "start": 25.42,
   "end": 26.64,
   "text": "l'équilibre rétrécit.",
   "beat": "balance"
  },
  {
   "start": 26.64,
   "end": 28.3,
   "text": "Marc ne tient plus debout.",
   "beat": "balance"
  },
  {
   "start": 30.8,
   "end": 31.08,
   "text": "Pourtant,",
   "beat": "crow"
  },
  {
   "start": 31.52,
   "end": 33.02,
   "text": "une corneille a un cerveau",
   "beat": "crow"
  },
  {
   "start": 33.02,
   "end": 34.16,
   "text": "de cette taille.",
   "beat": "crow"
  },
  {
   "start": 34.18,
   "end": 35.54,
   "text": "Elle fabrique des outils",
   "beat": "crow"
  },
  {
   "start": 35.54,
   "end": 36.94,
   "text": "et reconnaît les visages.",
   "beat": "crow"
  },
  {
   "start": 37.8,
   "end": 39.18,
   "text": "Son secret :",
   "beat": "dense"
  },
  {
   "start": 39.18,
   "end": 40.44,
   "text": "des neurones minuscules,",
   "beat": "dense"
  },
  {
   "start": 41.22,
   "end": 42.18,
   "text": "deux fois plus serrés que",
   "beat": "dense"
  },
  {
   "start": 42.18,
   "end": 43.04,
   "text": "ceux d'un singe.",
   "beat": "dense"
  },
  {
   "start": 44.4,
   "end": 45.04,
   "text": "Et à Marseille,",
   "beat": "case"
  },
  {
   "start": 45.04,
   "end": 45.74,
   "text": "en 2007,",
   "beat": "case"
  },
  {
   "start": 46.18,
   "end": 47.66,
   "text": "des médecins ont découvert",
   "beat": "case"
  },
  {
   "start": 47.66,
   "end": 49.08,
   "text": "un homme au cerveau réduit",
   "beat": "case"
  },
  {
   "start": 49.08,
   "end": 50.1,
   "text": "à une fine couche.",
   "beat": "case"
  },
  {
   "start": 52.4,
   "end": 53.06,
   "text": "Il était marié,",
   "beat": "normal"
  },
  {
   "start": 53.66,
   "end": 54.46,
   "text": "père de deux enfants,",
   "beat": "normal"
  },
  {
   "start": 54.46,
   "end": 55.72,
   "text": "et travaillait dans",
   "beat": "normal"
  },
  {
   "start": 55.72,
   "end": 56.28,
   "text": "l'administration.",
   "beat": "normal"
  },
  {
   "start": 58.4,
   "end": 59.28,
   "text": "Son cerveau avait eu des",
   "beat": "time"
  },
  {
   "start": 59.28,
   "end": 59.98,
   "text": "dizaines d'années pour",
   "beat": "time"
  },
  {
   "start": 59.98,
   "end": 61.04,
   "text": "s'adapter.",
   "beat": "time"
  },
  {
   "start": 61.04,
   "end": 61.44,
   "text": "Marc,",
   "beat": "time"
  },
  {
   "start": 61.84,
   "end": 62.34,
   "text": "une seule nuit.",
   "beat": "time"
  },
  {
   "start": 64.0,
   "end": 65.0,
   "text": "La taille compte moins que",
   "beat": "punch"
  },
  {
   "start": 65.0,
   "end": 65.38,
   "text": "le temps.",
   "beat": "punch"
  },
  {
   "start": 66.6,
   "end": 66.86,
   "text": "Et toi,",
   "beat": "cta"
  },
  {
   "start": 67.6,
   "end": 68.68,
   "text": "tu échangerais ton cerveau",
   "beat": "cta"
  },
  {
   "start": 68.68,
   "end": 69.34,
   "text": "contre celui d'une",
   "beat": "cta"
  },
  {
   "start": 69.34,
   "end": 69.78,
   "text": "corneille ?",
   "beat": "cta"
  }
 ],
