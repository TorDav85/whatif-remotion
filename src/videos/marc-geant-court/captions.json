  {
   "start": 0.1,
   "end": 1.2,
   "text": "Marc double de taille",
   "beat": "hook"
  },
  {
   "start": 1.2,
   "end": 1.74,
   "text": "chaque minute.",
   "beat": "hook"
  },
  {
   "start": 2.36,
   "end": 3.58,
   "text": "Son corps ne suit pas.",
   "beat": "hook"
  },
  {
   "start": 4.6,
   "end": 5.83,
   "text": "Minute trois :",
   "beat": "problem"
  },
  {
   "start": 5.83,
   "end": 7.06,
   "text": "quatorze mètres.",
   "beat": "problem"
  },
  {
   "start": 7.06,
   "end": 8.6,
   "text": "Ses genoux commencent déjà",
   "beat": "problem"
  },
  {
   "start": 8.6,
   "end": 9.16,
   "text": "à céder.",
   "beat": "problem"
  },
  {
   "start": 10.2,
   "end": 11.36,
   "text": "Le problème :",
   "beat": "law"
  },
  {
   "start": 11.36,
   "end": 12.2,
   "text": "sa taille double,",
   "beat": "law"
  },
  {
   "start": 12.56,
   "end": 13.76,
   "text": "mais son poids est",
   "beat": "law"
  },
  {
   "start": 13.76,
   "end": 15.48,
   "text": "multiplié par huit.",
   "beat": "law"
  },
  {
   "start": 15.48,
   "end": 16.16,
   "text": "Ses os,",
   "beat": "law"
  },
  {
   "start": 16.16,
   "end": 17.18,
   "text": "seulement par quatre.",
   "beat": "law"
  },
  {
   "start": 17.8,
   "end": 19.24,
   "text": "À soixante mètres,",
   "beat": "stomp"
  },
  {
   "start": 19.24,
   "end": 21.0,
   "text": "chaque pas est un petit",
   "beat": "stomp"
  },
  {
   "start": 21.0,
   "end": 21.48,
   "text": "séisme.",
   "beat": "stomp"
  },
  {
   "start": 23.2,
   "end": 24.54,
   "text": "Minute huit :",
   "beat": "eiffel"
  },
  {
   "start": 24.54,
   "end": 25.4,
   "text": "la tour Eiffel lui arrive",
   "beat": "eiffel"
  },
  {
   "start": 25.4,
   "end": 25.94,
   "text": "à la poitrine.",
   "beat": "eiffel"
  },
  {
   "start": 28.8,
   "end": 30.02,
   "text": "Minute treize :",
   "beat": "plane"
  },
  {
   "start": 30.02,
   "end": 31.34,
   "text": "il frôle les avions.",
   "beat": "plane"
  },
  {
   "start": 31.34,
   "end": 32.84,
   "text": "L'air devient rare.",
   "beat": "plane"
  },
  {
   "start": 34.2,
   "end": 35.5,
   "text": "Minute vingt-trois :",
   "beat": "earth"
  },
  {
   "start": 35.5,
   "end": 36.32,
   "text": "il est plus grand que",
   "beat": "earth"
  },
  {
   "start": 36.32,
   "end": 36.66,
   "text": "la Terre.",
   "beat": "earth"
  },
  {
   "start": 39.1,
   "end": 40.4,
   "text": "Et la Lune ?",
   "beat": "moon"
  },
  {
   "start": 40.4,
   "end": 41.4,
   "text": "Une bille dans sa main.",
   "beat": "moon"
  },
  {
   "start": 42.0,
   "end": 42.68,
   "text": "Tu l'arrêterais à quelle",
   "beat": "end"
  },
  {
   "start": 42.68,
   "end": 43.08,
   "text": "minute ?",
   "beat": "end"
  }
 ],
