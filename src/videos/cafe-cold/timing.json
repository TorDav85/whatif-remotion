    },
    {
      "id": "normal",
      "text": "À vingt degrés, Marc prend son café en terrasse.",
      "caption": "Le café de Marc.",
      "start": 4.62288,
      "duration": 2.71325,
      "end": 7.33613,
      "audio": "cafe-cold/normal.wav",
