{
  "name": "whatif-remotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render WhatIf out/whatif.mp4 --codec=h264",
    "still": "remotion still WhatIf out/frame.png --frame=300",
    "ambience": "node scripts/audio/ambience-whatif.mjs",
    "voice": "node scripts/audio/voice-piper.mjs",
    "voice:prepare": "node scripts/audio/python.mjs scripts/audio/xtts/prepare.py",
    "voice:add": "node scripts/audio/python.mjs scripts/audio/xtts/profiles.py add",
    "voice:list": "node scripts/audio/python.mjs scripts/audio/xtts/profiles.py list",
    "voice:use": "node scripts/audio/python.mjs scripts/audio/xtts/profiles.py use",
    "voice:xtts": "node scripts/audio/python.mjs scripts/audio/xtts/generate.py --output-dir voice-xtts --activate",
    "voice:check": "node scripts/audio/python.mjs scripts/check/voice.py",
    "render:with-voice": "npm run ambience && npm run voice:xtts && remotion render WhatIf out/whatif-xtts.mp4 --codec=h264",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/check/validate-scenarios.mjs",
    "test:project": "node --test scripts/check/project.test.mjs",
    "test:voice": "node scripts/audio/python.mjs scripts/check/voice_profiles_test.py",
    "predev": "node scripts/project/video.mjs prepare",
    "prerender": "node scripts/audio/ambience-whatif.mjs --if-missing",
    "render:nature": "remotion render NatureReprend out/nature.mp4 --codec=h264",
    "still:nature": "remotion still NatureReprend out/nature-frame.png --frame=600",
    "ambience:nature": "node scripts/audio/ambience-nature.mjs",
    "prerender:nature": "node scripts/audio/ambience-nature.mjs --if-missing",
    "render:heat": "remotion render Chaleur out/chaleur.mp4 --codec=h264",
    "still:heat": "remotion still Chaleur out/chaleur-frame.png --frame=1200",
    "ambience:heat": "node scripts/audio/ambience-heat.mjs",
    "prerender:heat": "node scripts/audio/ambience-heat.mjs --if-missing",
    "voice:heat": "node scripts/audio/voice-piper.mjs src/videos/heat/timeline.json",
    "render:v2": "remotion render WhatIfParisV2 out/whatif-paris-v2.mp4 --codec=h264",
    "prerender:v2": "node scripts/audio/ambience-whatif.mjs src/videos/paris-v2/scenario.json",
    "still:v2": "remotion still WhatIfParisV2 out/paris-v2.png --frame=600",
    "prestill:v2": "node scripts/audio/ambience-whatif.mjs src/videos/paris-v2/scenario.json --if-missing",
    "ambience:v2": "node scripts/audio/ambience-whatif.mjs src/videos/paris-v2/scenario.json",
    "voice:v2": "node scripts/audio/voice-piper.mjs src/videos/paris-v2/scenario.json",
    "render:v3": "remotion render WhatIfParisV3 out/whatif-paris-v3.mp4 --codec=h264",
    "prerender:v3": "node scripts/audio/ambience-paris.mjs",
    "still:v3": "remotion still WhatIfParisV3 out/paris-v3.png --frame=660",
    "prestill:v3": "node scripts/audio/ambience-paris.mjs --if-missing",
    "ambience:v3": "node scripts/audio/ambience-paris.mjs",
    "voice:v3": "node scripts/audio/voice-piper.mjs src/videos/paris-v3/scenario.json",
    "render:v3:rework": "remotion render WhatIfParisV3 out/whatif-paris-v3-retravaillee.mp4 --codec=h264",
    "prerender:v3:rework": "node scripts/audio/ambience-paris.mjs",
    "render:v4": "remotion render WhatIfParisV4 out/whatif-paris-v4.mp4 --codec=h264",
    "prerender:v4": "node scripts/audio/ambience-paris.mjs src/videos/paris-v4/scenario.json",
    "still:v4": "remotion still WhatIfParisV4 out/paris-v4.png --frame=120",
    "prestill:v4": "node scripts/audio/ambience-paris.mjs src/videos/paris-v4/scenario.json --if-missing",
    "ambience:v4": "node scripts/audio/ambience-paris.mjs src/videos/paris-v4/scenario.json",
    "voice:v4": "node scripts/audio/voice-piper.mjs src/videos/paris-v4/scenario.json",
    "render:v4:solar": "remotion render WhatIfParisV4 out/whatif-paris-v4-systeme-solaire.mp4 --codec=h264",
    "prerender:v4:solar": "node scripts/audio/ambience-paris.mjs src/videos/paris-v4/scenario.json",
    "assets:planets": "node scripts/assets/fetch-planets.mjs",
    "render:v6": "remotion render WhatIfParisV6 out/whatif-paris-v6.mp4 --codec=h264",
    "prerender:v6": "node scripts/audio/ambience-paris.mjs src/videos/paris-v6/scenario.json",
    "still:v6": "remotion still WhatIfParisV6 out/paris-v6.png --frame=90",
    "prestill:v6": "node scripts/audio/ambience-paris.mjs src/videos/paris-v6/scenario.json --if-missing",
    "ambience:v6": "node scripts/audio/ambience-paris.mjs src/videos/paris-v6/scenario.json",
    "render:tiktok": "remotion render WhatIfParisTikTok out/whatif-paris-tiktok-70s.mp4 --codec=h264",
    "prerender:tiktok": "node scripts/audio/ambience-paris.mjs src/videos/paris-tiktok/scenario.json",
    "voice:tiktok": "powershell.exe -NoProfile -File scripts/audio/voice-windows.ps1",
    "assets:tiktok": "python scripts/export/tiktok.py",
    "video": "node scripts/project/video.mjs",
    "video:sync": "node scripts/project/video.mjs sync",
    "render:nature2": "remotion render NatureReprendV2 out/nature2.mp4 --codec=h264",
    "still:nature2": "remotion still NatureReprendV2 out/nature2-frame.png --frame=600",
    "ambience:nature2": "node scripts/audio/ambience-nature.mjs src/videos/nature-v2/nature.json public/nature2.wav",
    "prerender:nature2": "node scripts/audio/ambience-nature.mjs src/videos/nature-v2/nature.json public/nature2.wav --if-missing",
    "prestill:nature2": "node scripts/audio/ambience-nature.mjs src/videos/nature-v2/nature.json public/nature2.wav --if-missing",
    "render:gravity": "remotion render Gravite out/gravite.mp4 --codec=h264",
    "still:gravity": "remotion still Gravite out/gravite-frame.png --frame=900",
    "ambience:gravity": "node scripts/audio/ambience-gravity.mjs",
    "prerender:gravity": "node scripts/audio/ambience-gravity.mjs --if-missing",
    "prestill:gravity": "node scripts/audio/ambience-gravity.mjs --if-missing",
    "render:assets": "remotion render Assets out/assets.mp4 --codec=h264",
    "still:assets": "remotion still Assets out/assets-frame.png --frame=60",
    "render:interior": "remotion render AssetsInterieur out/assets-interieur.mp4 --codec=h264",
    "still:interior": "remotion still AssetsInterieur out/interieur-frame.png --frame=60",
    "still:city": "remotion still AssetsVille out/assets-ville.png --frame=60",
    "render:city": "remotion render AssetsVille out/assets-ville-1.02.mp4 --codec=h264"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.539",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0"
  }
}
