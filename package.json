{
  "name": "whatif-remotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render WhatIf out/whatif.mp4 --codec=h264",
    "still": "remotion still WhatIf out/frame.png --frame=300",
    "ambience": "node scripts/make-ambience.mjs",
    "voice": "node scripts/make-voice.mjs",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/make-ambience.mjs --if-missing",
    "prerender": "node scripts/make-ambience.mjs --if-missing",
    "render:nature": "remotion render NatureReprend out/nature.mp4 --codec=h264",
    "still:nature": "remotion still NatureReprend out/nature-frame.png --frame=600",
    "ambience:nature": "node scripts/make-nature-ambience.mjs",
    "prerender:nature": "node scripts/make-nature-ambience.mjs --if-missing",
    "render:nature2": "remotion render NatureReprendV2 out/nature2.mp4 --codec=h264",
    "still:nature2": "remotion still NatureReprendV2 out/nature2-frame.png --frame=600",
    "ambience:nature2": "node scripts/make-nature-ambience.mjs src/nature2/nature.json public/nature2.wav",
    "prerender:nature2": "node scripts/make-nature-ambience.mjs src/nature2/nature.json public/nature2.wav --if-missing",
    "render:heat": "remotion render Chaleur out/chaleur.mp4 --codec=h264",
    "still:heat": "remotion still Chaleur out/chaleur-frame.png --frame=1200",
    "ambience:heat": "node scripts/make-heat-ambience.mjs",
    "prerender:heat": "node scripts/make-heat-ambience.mjs --if-missing",
    "voice:heat": "node scripts/make-voice.mjs src/heat/timeline.json",
    "render:gravity": "remotion render Gravite out/gravite.mp4 --codec=h264",
    "still:gravity": "remotion still Gravite out/gravite-frame.png --frame=900",
    "ambience:gravity": "node scripts/make-gravity-ambience.mjs",
    "prerender:gravity": "node scripts/make-gravity-ambience.mjs --if-missing",
    "render:assets": "remotion render Assets out/assets.mp4 --codec=h264",
    "still:assets": "remotion still Assets out/assets-frame.png --frame=60",
    "render:interior": "remotion render AssetsInterieur out/assets-interieur.mp4 --codec=h264",
    "still:interior": "remotion still AssetsInterieur out/interieur-frame.png --frame=60"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.539",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0"
  }
}
